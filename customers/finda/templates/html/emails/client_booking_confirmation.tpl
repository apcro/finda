<!--[if mso]><table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding-right: 10px; padding-left: 10px; padding-top: 10px; padding-bottom: 10px; font-family: Arial, sans-serif"><![endif]-->
<div style="color:#000000;font-family:Arial, 'Helvetica Neue', Helvetica, sans-serif;line-height:1.2;padding-top:10px;padding-right:10px;padding-bottom:10px;padding-left:10px;">
<p style="margin: 0; direction: ltr; color: #000000; line-height: 1.2; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 14px; mso-line-height-alt: 17px;"><span style="color: #000000; font-size: 14px;"><strong>Cancellation Policy</strong></span></p>
<p style="margin: 0; direction: ltr; color: #000000; line-height: 1.2; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; mso-line-height-alt: NaNpx;"></p>
<p style="margin: 0; direction: ltr; color: #000000; line-height: 1.2; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 14px; mso-line-height-alt: 17px;"><span style="color: #000000; font-size: 14px;">If you need to cancel your booking, please do so no less than 48 hours in advance to respect the members of iDAL's professional community. A late cancellation might result in a two week-long absence from the model board and a negative rating, thereby decreasing your chances of receiving future bookings. Please refer to our </span><a href="https://www.idal.co/terms" style="color: #000000; font-size: 14px;" target="_blank" title="cancellation policy"><span style="color: #000000; font-size: 14px;">cancellation policy</span></a><span style="color: #000000; font-size: 14px;">.</span></p>
<p style="margin: 0; direction: ltr; color: #000000; line-height: 1.2; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; mso-line-height-alt: NaNpx;"></p>
