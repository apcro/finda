			<li class=""><a href="#step4" class="bullet-item-link circlestep4"><i class="circle"></i><span class="bullet-nav-title">Step 4</span></a></li>
		</ul>
	</div>
	<div class="downarrow-persistent text-center" data-scrollto="landing-insta"><i class="fa fa-angle-down"></i></div>
</section>