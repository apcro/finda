<section id="time-to-bloom" class="fullscreen about">
	<div class="text-block center-vertical">
    	<div class="bloom-title">it's your time to bloom</div>
    	<div class="text-center">
    		<div class="bloom-button button hvr bg-red white hvr-white-textred">Receive your blooming surprise</div>
    	</div>
	</div>
    <div class="downarrow-persistent text-center" data-scrollto="landing-tutorial"><i class="fa fa-angle-down"></i></div>
</section>
<section id="time-to-bloom-form">
    <div class="modalWhite flowerTime">
    	<div class="row">
    		<div class="column">
				<p>As a part of #itsmytimetobloom campaign, Idal and <a href="http://frontrowflorist.com/" target="_blank">Front Row Florist</a> have united to gift models with a blooming surprise and fill their days with colourful inspiration. Please leave us your instagram account, email address and address where we can deliver your surprise.</p>
				<label style="margin-top: 2em;">What colour makes you bloom?</label>
				<div class="row nopad flower_selector">
					<div class="column nopad">
        				<select name="bloom_colour" id="bloom_colour">
        					<option value="black" disabled="disabled" selected="selected">Please select</option>
        					<option value="pink">Pink</option>
        					<option value="yellow">Yellow</option>
        					<option value="red">Red</option>
        					<option value="white">White</option>
        					<option value="purple">Purple</option>
        				</select> 
					</div>
					<div class="column text-center">
						<img class="flower_image" src="/images/engagement/flower_pink.jpg" />
					</div>
				</div>
    			<label>Name</label>
    			<input type="text" class="bloom_name" name="bloom_name" />
    			<label>Email address</label>
    			<input type="text" class="bloom_email" name="bloom_email" />
    			<label>Instagram</label>
    			<input type="text" class="bloom_instagram" name="bloom_instagram" />
    			<label>Delivery address</label>
    			<textarea rows="1" cols="1" class="bloom_delivery" name="bloom_delivery"></textarea>
    			<div class="privacy_checkbox"><input type="checkbox" id="bloom_privacy" name="bloom_privacy"> I agree to the Idal <a href="/terms">Terms &amp; Conditions</a> and <a href="/privacy">Privacy Policy</a>.</div>
    			<div class="text-center">
        			<div class="button hvr bg-black white hvr-white-textblack sendflower">Surprise me</div>
    			</div>
    		</div>
    	</div>
    </div>
</section>